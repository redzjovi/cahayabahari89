.env
.env.*
!.env.example
!.env.test

# Logs
*.log
logs/
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~

# Vite timestamp artifacts
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Kilo agent state
.kilo/
