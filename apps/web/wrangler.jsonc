{
	"name": "cahayabahari89-web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-09-01",
	"compatibility_flags": [
		"nodejs_als"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cahayabahari89-db",
			"database_id": "745b4d5a-23c2-4189-9942-fd6966a20b68",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "cahayabahari89-images"
		}
	],
	"vars": {}
}