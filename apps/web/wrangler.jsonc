{
	"name": "cahayabahari89-web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-09-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cahayabahari89-db",
			"database_id": "ca94baff-e473-475c-a22e-571e6f1a415c",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "cahayabahari89-images"
		}
	],
	"vars": {
		"ADMIN_TOKEN": "dev-token"
	}
}
