{
	"name": "web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-09-01",
	"compatibility_flags": [
		"nodejs_als"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cahayabahari89-db",
			"database_id": "17c04c23-cefa-42fb-b274-1c290d1146af",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "cahayabahari89-r2"
		}
	],
	"vars": {}
}